+  if (typeof credentials.access_token !== "string" || !credentials.access_token.trim()) return "codexAuth.importMissingTokens";
+  if (format === "codex" && typeof credentials.id_token !== "string") return "codexAuth.importMissingTokens";
+  return null;
+}
+
+function pastedTokenFileValidationError(text: string, format: TokenImportFormat | null): TKey | null {
