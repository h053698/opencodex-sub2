+    : null;
+}
+
+/** Validate the selected public JSON shape locally; token validity remains server-side. */
+function tokenFileValidationError(document: unknown, format: TokenImportFormat): TKey | null {
+  const root = record(document);
+  if (!root) return "codexAuth.importInvalidJson";
+  const row = format === "sub2api"
+    ? (Array.isArray(root.accounts) ? root.accounts.find(value => record(value)?.platform === "openai" || record(value)?.type === "codex") : null)
+    : root;
+  const account = record(row);
+  if (!account) return "codexAuth.importInvalidJson";
+  if (format === "cpa" && account.type !== "codex") return "codexAuth.importInvalidJson";
+  if (format === "codex" && account.auth_mode !== "chatgpt") return "codexAuth.importInvalidJson";
