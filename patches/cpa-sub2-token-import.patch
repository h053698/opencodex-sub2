new file mode 100644
index 0000000..77a3c2c
--- /dev/null
+++ b/src/codex/account-import.ts
@@ -0,0 +1,110 @@
+import { createHash } from "node:crypto";
+import { extractAccountId, extractEmail, decodeJwtPayload } from "../oauth/chatgpt";
+import { extractChatgptPlanType } from "./plan";
+import { isValidCodexAccountId } from "./account-id";
+import type { CodexAccountCredentials } from "../types";
+
+/** Maximum number of credentials accepted from one local JSON upload. */
+export const CODEX_TOKEN_IMPORT_MAX_RECORDS = 25;
+const TOKEN_MAX_BYTES = 16 * 1024;
+export type CodexTokenImportFormat = "sub2api" | "cpa" | "codex";
+
+export interface ImportedCodexAccount {
+  id: string;
+  email: string;
+  plan?: string;
+  credential: CodexAccountCredentials;
+}
+
+function object(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? value as Record<string, unknown>
+    : null;
+}
+
+function text(value: unknown): string | undefined {
+  return typeof value === "string" && value.trim() ? value.trim() : undefined;
+}
+
+function token(value: unknown): string | undefined {
+  const result = text(value);
+  return result && Buffer.byteLength(result, "utf8") <= TOKEN_MAX_BYTES ? result : undefined;
+}
+
+function expiresAt(value: unknown, accessToken: string): number {
+  if (typeof value === "number" && Number.isFinite(value)) {
+    return value > 1e11 ? value : value * 1000;
+  }
+  if (typeof value === "string") {
+    const numeric = Number(value);
+    if (Number.isFinite(numeric) && value.trim()) return numeric > 1e11 ? numeric : numeric * 1000;
+    const parsed = Date.parse(value);
+    if (Number.isFinite(parsed)) return parsed;
+  }
+  const exp = decodeJwtPayload(accessToken)?.exp;
+  if (typeof exp === "number" && Number.isFinite(exp)) return exp * 1000;
+  // Opaque access tokens have no readable expiry. Warmup validates them upstream;
+  // retain them briefly so an accepted access-only export can serve immediately.
+  return Date.now() + 15 * 60_000;
+}
+
+function poolId(chatgptAccountId: string, email: string): string {
+  const candidate = chatgptAccountId.replace(/[^A-Za-z0-9._-]/g, "-").slice(0, 64);
+  if (isValidCodexAccountId(candidate)) return candidate;
+  const digest = createHash("sha256").update(`${chatgptAccountId}\0${email}`).digest("hex").slice(0, 16);
+  return `import-${digest}`;
+}
+
+function parseRecord(raw: unknown, format: CodexTokenImportFormat): ImportedCodexAccount | null {
+  const row = object(raw);
+  if (!row) return null;
+  if (format === "sub2api" && !object(row.credentials)) return null;
+  if (format === "cpa" && text(row.type)?.toLowerCase() !== "codex") return null;
+  if (format === "codex" && text(row.auth_mode)?.toLowerCase() !== "chatgpt") return null;
+  const credentials = object(row.credentials) ?? object(row.tokens) ?? row;
+  const extra = object(row.extra) ?? {};
+  const platform = text(row.platform) ?? text(row.type);
+  if (format === "sub2api" && platform && !["openai", "codex"].includes(platform.toLowerCase())) return null;
+
+  const accessToken = token(credentials.access_token ?? credentials.accessToken);
+  const refreshToken = token(credentials.refresh_token ?? credentials.refreshToken) ?? "";
+  const idToken = token(credentials.id_token ?? credentials.idToken);
+  if (!accessToken) return null;
+  const chatgptAccountId = text(credentials.chatgpt_account_id)
+    ?? text(credentials.account_id)
+    ?? extractAccountId(idToken, accessToken);
+  if (!chatgptAccountId || Buffer.byteLength(chatgptAccountId, "utf8") > 256) return null;
+  const email = (text(credentials.email) ?? text(extra.email) ?? extractEmail(idToken, accessToken) ?? "").toLowerCase();
+  if (!email || email.length > 254) return null;
+  const plan = text(credentials.plan_type) ?? text(row.plan_type) ?? extractChatgptPlanType(idToken, accessToken);
+  return {
+    id: poolId(chatgptAccountId, email),
+    email,
+    plan,
+    credential: {
+      accessToken,
+      refreshToken,
+      expiresAt: expiresAt(credentials.expires_at ?? credentials.expired ?? row.expired, accessToken),
+      chatgptAccountId,
+    },
+  };
+}
+
+/** Parse a CPA file or sub2api's `{ accounts: [...] }` export without retaining its raw document. */
+export function parseCodexTokenImport(document: unknown, format: CodexTokenImportFormat): ImportedCodexAccount[] {
+  const root = object(document);
+  if (!root) return [];
+  if (format === "sub2api" && !Array.isArray(root.accounts)) return [];
+  if (format !== "sub2api" && Array.isArray(root.accounts)) return [];
+  const rows = Array.isArray(root.accounts) ? root.accounts : [root];
+  if (rows.length > CODEX_TOKEN_IMPORT_MAX_RECORDS) return [];
+  const seen = new Set<string>();
+  const accounts: ImportedCodexAccount[] = [];
+  for (const row of rows) {
+    const account = parseRecord(row, format);
+    if (!account || seen.has(account.credential.chatgptAccountId)) continue;
+    seen.add(account.credential.chatgptAccountId);
+    accounts.push(account);
+  }
+  return accounts;
+}
